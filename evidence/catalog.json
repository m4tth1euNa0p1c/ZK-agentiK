  "claims": [
    {
      "id": "horizon-conditional-mathematics",
      "kind": "mathematical-derivation",
      "status": "derived",
      "relation": "Connaissance d'ouvertures de A-G et C-A dans deux plages 32 bits, liaison aux engagements signés et domaine source u64 ; 1 <= a <= 2^32, 0 <= c-a < 2^32.",
      "limitations": [
        "Démonstrations conditionnelles, pas preuve formelle machine ou audit de la bibliothèque.",
        "La simple existence d'une ouverture Pedersen ne suffit pas ; connaissance extractible, binding et contrat d'émission sont requis.",
        "Ni cumul, franchise, vérité source, anonymat, nouveauté ou sécurité post-quantique."
      ],
