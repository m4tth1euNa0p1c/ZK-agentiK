{
  "$id": "urn:zk-mcp:envelope:1.0-draft-01",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "1.0"
    },
    "zkvm_backend": {
      "type": "string",
      "enum": [
        "native-simulator",
        "sp1",
        "risc0",
        "magnetar"
      ]
    },
    "security_profile": {
      "type": "string",
      "enum": [
        "simulation",
        "zk"
      ]
    },
    "elf_image_id": {
      "type": "string",
      "pattern": "^(?:sim-sha256|sha256):[0-9a-f]{64}$"
    },
    "public_inputs_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_inputs": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._:/-]+$"
        },
        "context": {
          "type": "object",
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._:/-]+$"
            },
            "tool": {
              "type": "string",
              "const": "verifiable_gitlab_merge"
            },
            "project_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "merge_request_iid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "head_sha": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          },
          "required": [
            "tenant_id",
            "tool",
            "project_id",
            "merge_request_iid",
            "head_sha"
          ],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "min_reviewers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "critical": {
              "type": "object",
              "properties": {
                "max_evidence_age_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_canary_error_rate_ppm": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "max_canary_p99_latency_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "min_canary_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_canary_traffic_percent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "required": [
                "max_evidence_age_ms",
                "max_canary_error_rate_ppm",
                "max_canary_p99_latency_ms",
                "min_canary_duration_ms",
                "max_canary_traffic_percent"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "min_reviewers"
          ],
          "additionalProperties": false
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_commitment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "audience",
        "context",
        "policy",
        "policy_hash",
        "input_commitment",
        "nonce",
        "issued_at_ms",
        "expires_at_ms"
      ],
      "additionalProperties": false
    },
    "public_outputs": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "violations_mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "critical_violations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16383
        }
      },
      "required": [
        "allow",
        "violations_mask"
      ],
      "additionalProperties": false
    },
    "proof_bytes": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1400000,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "spec_version",
    "zkvm_backend",
    "security_profile",
    "elf_image_id",
    "public_inputs_hash",
    "public_inputs",
    "public_outputs",
    "proof_bytes",
    "timestamp"
  ],
  "additionalProperties": false
}
